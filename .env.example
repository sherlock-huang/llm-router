# llm-router environment example
# Copy this file to .env and replace placeholders with your real values.

# Provider API keys
STEP_API_KEY=your_stepfun_api_key_here
ARK_API_KEY=your_ark_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here

# Local server port
PORT=3044

# Keep debug env inspection off by default.
# Set to true only for local debugging.
ENABLE_DEBUG_ENV=false
