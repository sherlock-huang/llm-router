# MOP - 环境变量配置示例
# 复制此文件为 .env 并填入你的 API Key

# ===================
# 模型 API Keys
# ===================

# 阶跃星辰 (stepfun)
# 获取地址: https://platform.stepfun.com/
STEP_API_KEY=your_stepfun_api_key_here

# 字节跳动 ark (volcengine)
# 获取地址: https://console.volcengine.com/ark
ARK_API_KEY=your_ark_api_key_here

# MiniMax
# 获取地址: https://platform.minimaxi.com/
MINIMAX_API_KEY=your_minimax_api_key_here

# ===================
# 服务配置
# ===================

# 服务端口 (默认 3044)
PORT=3044
